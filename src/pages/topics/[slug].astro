---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardList from "../../components/CardList.astro";
import { writingPillars } from "../../data/pillars";
import { socials } from "../../data/socials";

export async function getStaticPaths() {
  return writingPillars.map((pillar) => ({
    params: { slug: pillar.id },
    props: { pillar },
  }));
}

const { pillar } = Astro.props;

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = allPosts
  .filter((post) => post.data.pillar === pillar.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const linkOut = socials.find((s) => s.label === "LinkedIn") ?? socials[0];
---

<BaseLayout title={pillar.label} description={pillar.description}>
  <section class="section container">
    <a href="/topics" class="back-link">← All topics</a>
    <h1 class="page-title">{pillar.label}</h1>
    <p class="muted">{pillar.description}</p>

    {
      posts.length > 0 ? (
        <div style="margin-top: 24px;">
          <CardList
            items={posts.map((post) => ({
              kind: "Article" as const,
              title: post.data.title,
              description: post.data.description,
              href: `/writing/${post.id}`,
              date: post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }),
            }))}
          />
        </div>
      ) : (
        <p class="muted" style="margin-top: 24px;">
          Nothing published under {pillar.label} yet — in the meantime, I write regularly on{" "}
          <a href={linkOut.href} target="_blank" rel="noopener noreferrer">
            {linkOut.label}
          </a>
          .
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .back-link {
    font-size: 14px;
    color: var(--ink-faint);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--primary);
  }
</style>
