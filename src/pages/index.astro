---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Featured from "../components/Featured.astro";
import Experience from "../components/Experience.astro";
import VolunteerWork from "../components/VolunteerWork.astro";
import LatestArticles from "../components/LatestArticles.astro";
import Contact from "../components/Contact.astro";
import { profile } from "../data/profile";
import { socials } from "../data/socials";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.displayName,
  alternateName: profile.name,
  jobTitle: "Data & AI Consultant",
  url: Astro.site?.toString(),
  sameAs: socials.filter((s) => s.href.startsWith("http")).map((s) => s.href),
};
---

<BaseLayout title={profile.name} structuredData={structuredData}>
  <Hero />
  <About />
  <Featured />
  <Experience />
  <VolunteerWork />
  <LatestArticles />
  <Contact />
</BaseLayout>
