---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resources } from "../data/resources";
---

<BaseLayout title="Resources" description="Tools, learning, and other recommended links.">
  <section class="section container">
    <a href="/" class="back-link">← Home</a>
    <span class="eyebrow" style="margin-top: 16px;">Resources</span>
    <div class="resource-groups">
      {
        resources.map((group) => (
          <div class="resource-group">
            <h3 class="resource-heading">{group.category}</h3>
            <ul class="resource-list">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.label}
                  </a>
                  {item.note && <span class="muted"> — {item.note}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    font-size: 14px;
    color: var(--ink-faint);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--primary);
  }
  .resource-groups {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 24px;
  }
  .resource-heading {
    font-size: 15px;
    margin: 0 0 8px;
    color: var(--ink);
  }
  .resource-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
</style>
