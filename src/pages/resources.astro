---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resources } from "../data/resources";
import { resourcePillars, pillarGroups } from "../data/pillars";
---

<BaseLayout
  title="Resources"
  description="Tools, learning, and other recommended links, by topic."
  robots="noindex,follow"
>
  <section class="section container wide">
    <a href="/" class="back-link">← Home</a>
    <h1 class="page-title">Resources</h1>

    <div class="group-grid">
      {
        pillarGroups.map((group) => (
          <div class="group-col">
            <h2 class="group-heading">{group}</h2>
            {resourcePillars
              .filter((p) => p.group === group)
              .map((pillar) => {
                const items = resources.filter((r) => r.pillar === pillar.id);
                return (
                  <div id={pillar.id} class="pillar-block">
                    <h3 class="pillar-heading">{pillar.label}</h3>
                    {items.length > 0 ? (
                      <ul class="resource-list">
                        {items.map((item) => (
                          <li>
                            <a href={item.href} target="_blank" rel="noopener noreferrer">
                              {item.label}
                            </a>
                            {item.note && <span class="muted"> — {item.note}</span>}
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="muted small">Nothing here yet.</p>
                    )}
                  </div>
                );
              })}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .wide {
    max-width: 920px;
  }
  .back-link {
    font-size: 14px;
    color: var(--ink-faint);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--primary);
  }
  .group-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 28px;
  }
  .group-heading {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-soft);
  }
  .pillar-block {
    margin-bottom: 20px;
  }
  .pillar-heading {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .resource-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14.5px;
  }
  .small {
    font-size: 13px;
  }

  @media (max-width: 520px) {
    .group-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
