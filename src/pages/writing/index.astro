---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterableList from "../../components/FilterableList.astro";
import { pillars } from "../../data/pillars";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

// Reuse FilterableList's kind-grouping for pillars instead of Featured's
// talk/article/video kinds — "kind" here is the pillar label, so "By
// category" groups articles by topic, and the year filter works the same
// way it does everywhere else.
const items = allPosts.map((post) => {
  const pillar = pillars.find((p) => p.id === post.data.pillar);
  return {
    kind: pillar?.label ?? post.data.pillar,
    title: post.data.title,
    description: post.data.description,
    href: `/writing/${post.id}`,
    date: post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }),
    year: post.data.date.getFullYear(),
  };
});

// Every tag used across published posts, most-used first — rendered as
// links to the /tags/<tag> pages (real crawlable pages, so this doubles as
// the tag "filter" without a second JS filter fighting the year filter).
const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).map(([tag]) => tag);
---

<BaseLayout title="All Articles" description="Every article published on this site, filterable by topic, year, and tag.">
  <section class="section container">
    <a href="/" class="back-link">← Home</a>
    <h1 class="page-title">All articles</h1>

    {
      allTags.length > 0 && (
        <div class="tag-row" style="margin-bottom: 20px;">
          {allTags.map((tag) => (
            <a class="tag tag-sm" href={`/tags/${tag}`}>
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    {
      items.length > 0 ? (
        <FilterableList items={items} />
      ) : (
        <p class="muted" style="margin-top: 24px;">
          Nothing published yet. Browse by topic using the <a href="/topics">Writing</a> menu above instead.
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .back-link {
    font-size: 14px;
    color: var(--ink-faint);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--primary);
  }
</style>
