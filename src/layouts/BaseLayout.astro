---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description?: string;
  // Set only for a post that's canonically published elsewhere (e.g.
  // mirrored from/to another platform later) — every other page defaults
  // to its own URL automatically, which is the correct canonical for
  // everything on the site today.
  canonicalUrl?: string;
}

const { title, description = profile.tagline, canonicalUrl } = Astro.props;
const pageTitle = title === profile.name ? title : `${title} · ${profile.name}`;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/og-image.png", Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <Analytics />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
