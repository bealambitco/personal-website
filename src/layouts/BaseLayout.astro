---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description?: string;
  // Thin navigation and archive pages stay usable and crawlable but can
  // opt out of search results with "noindex,follow".
  robots?: "index,follow" | "noindex,follow";
  // Set only for a post that's canonically published elsewhere (e.g.
  // mirrored from/to another platform later) — every other page defaults
  // to its own URL automatically, which is the correct canonical for
  // everything on the site today.
  canonicalUrl?: string;
  // "article" for blog posts (better link-preview semantics); defaults to
  // "website" for everything else.
  ogType?: "website" | "article";
  // Optional schema.org JSON-LD object (Person on the homepage, BlogPosting
  // on articles) — serialized into a <script type="application/ld+json">.
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = profile.tagline,
  robots = "index,follow",
  canonicalUrl,
  ogType = "website",
  structuredData,
} = Astro.props;
const pageTitle = title === profile.name ? title : `${title} · ${profile.name}`;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/og-image.png", Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title={profile.name} href={new URL("/rss.xml", Astro.site)} />
    {
      /* JSON-LD must be raw JSON, so set:html is required here. The data is
         authored in our own source (never user input), and `<` is escaped to
         rule out any </script> breakout even in principle. */
      structuredData && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
      )
    }
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
