---
import type { LinkItem } from "../data/link-item";

// Shared renderer for any list of link cards (Featured, Experience,
// Volunteer Work, Latest Articles, topic pages). Internal links (starting
// with "/") open in the same tab; external links (starting with "http")
// open in a new tab and get a small "↗" cue so it's clear they leave the
// site. Each card carries a `data-year` attribute so FilterableList.astro
// can show/hide entries by year.
interface Props {
  items: LinkItem[];
}

const { items } = Astro.props;
---

<div class="card-list">
  {
    items.map((item) => {
      const isExternal = item.href.startsWith("http");
      return (
        <div class="card-entry" data-year={item.year ?? ""}>
          {item.embedUrl && (
            <div class="embed-frame">
              <iframe
                src={item.embedUrl}
                title={item.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
                sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"
              />
            </div>
          )}
          <a
            class="card-link"
            href={item.href}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            <div class="card-kind">
              {item.kind}
              {item.date && ` · ${item.date}`}
              {isExternal && <span class="card-external"> ↗</span>}
            </div>
            <div class="card-title">{item.title}</div>
            <div class="card-description">{item.description}</div>
            {item.tags && item.tags.length > 0 && (
              <div class="tag-row" style="margin-top: 8px;">
                {item.tags.map((tag) => (
                  <span class="tag tag-sm">{tag}</span>
                ))}
              </div>
            )}
          </a>
        </div>
      );
    })
  }
</div>
