---
import type { LinkItem } from "../data/link-item";
import { getPreviewImage } from "../lib/link-preview";

// Shared renderer for any list of link cards (Featured, Experience,
// Volunteer Work, Latest Articles, topic pages). Internal links (starting
// with "/") open in the same tab; external links (starting with "http")
// open in a new tab and get a small "↗" cue so it's clear they leave the
// site. Each card carries a `data-year` attribute so FilterableList.astro
// can show/hide entries by year.
interface Props {
  items: LinkItem[];
  // "grid" renders compact bordered tiles instead of full-width rows —
  // use it for lists that are long and don't need much room per entry
  // (e.g. certifications). Defaults to the row layout everywhere else.
  layout?: "list" | "grid";
}

const { items, layout = "list" } = Astro.props;

// URLs where an og:image exists but is never actually representative of
// the specific entry, so auto-fetching it just adds visual noise:
// - linkedin.com/in/... is a personal profile page — its image is always
//   the same profile photo, not a preview of whatever it's linked from.
// - learn.microsoft.com credential pages all share one generic sitewide
//   banner, not a per-credential image.
function shouldSkipPreview(url: string): boolean {
  return /linkedin\.com\/in\//i.test(url) || /learn\.microsoft\.com/i.test(url);
}

// Auto-fetch a real preview image for external links that don't already
// have one set by hand — best-effort, silently skipped if it fails or if
// the source is known not to give a meaningful image (see above).
const resolvedItems = await Promise.all(
  items.map(async (item) => {
    if (!item.href || item.imageUrl || item.embedUrl || !item.href.startsWith("http") || shouldSkipPreview(item.href))
      return item;
    const preview = await getPreviewImage(item.href);
    return preview ? { ...item, imageUrl: preview } : item;
  }),
);
---

<div class={`card-list ${layout}`}>
  {
    resolvedItems.map((item) => {
      const isExternal = !!item.href?.startsWith("http");
      const hasThumb = !item.embedUrl && !!item.imageUrl;
      const Tag = item.href ? "a" : "div";
      return (
        <div class="card-entry" data-year={item.year ?? ""}>
          {item.embedUrl && (
            <div class="embed-frame">
              <iframe
                src={item.embedUrl}
                title={item.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
                sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"
              />
            </div>
          )}
          <Tag
            class={`card-link${hasThumb ? " has-thumb" : ""}${item.expired ? " is-expired" : ""}${item.href ? "" : " no-link"}`}
            href={item.href}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            {hasThumb && <img class="card-thumb" src={item.imageUrl} alt="" loading="lazy" />}
            <div class="card-body">
              <div class="card-kind">
                {item.kind}
                {item.date && ` · ${item.date}`}
                {item.expired && <span class="card-expired"> · Expired</span>}
                {isExternal && <span class="card-external"> ↗</span>}
              </div>
              <div class="card-title">{item.title}</div>
              {item.description && <div class="card-description">{item.description}</div>}
              {item.tags && item.tags.length > 0 && (
                <div class="tag-row" style="margin-top: 8px;">
                  {item.tags.map((tag) => (
                    <span class="tag tag-sm">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </Tag>
        </div>
      );
    })
  }
</div>
