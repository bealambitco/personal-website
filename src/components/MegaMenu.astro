---
import { pillars, pillarGroups } from "../data/pillars";

// Shared 3-column dropdown body used by both the "Writing" and "Resources"
// nav items — columns are the pillar groups (Technical/Industry/Life) from
// pillars.ts. `hrefFor` decides where each pillar link points (a page for
// Writing, an anchor for Resources).
interface Props {
  topLinks: { href: string; label: string }[];
  hrefFor: (pillarId: string) => string;
}

const { topLinks, hrefFor } = Astro.props;
---

<div class="mega">
  {
    topLinks.length > 0 && (
      <div class="mega-top">
        {topLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    )
  }
  <div class="mega-columns">
    {
      pillarGroups.map((group) => (
        <div class="mega-col">
          <div class="mega-col-heading">{group}</div>
          {pillars
            .filter((p) => p.group === group)
            .map((p) => (
              <a href={hrefFor(p.id)}>{p.label}</a>
            ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .mega {
    display: flex;
    flex-direction: column;
  }
  .mega-top {
    display: flex;
    gap: 4px;
    flex-direction: column;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border-soft);
  }
  .mega-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(140px, 1fr));
    gap: 20px;
  }
  .mega-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mega-col-heading {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 4px;
  }
  .mega a {
    padding: 5px 8px;
    margin-inline: -8px;
    border-radius: 6px;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 14px;
    white-space: nowrap;
  }
  .mega a:hover {
    color: var(--primary);
    background: var(--bg-raised);
  }

  @media (max-width: 640px) {
    .mega-columns {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
