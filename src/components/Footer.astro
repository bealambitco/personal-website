---
import { profile } from "../data/profile";
import { getLiveEcosystemLinks } from "../data/ecosystem";

const year = new Date().getFullYear();
const ecosystem = getLiveEcosystemLinks();
---

<footer class="footer">
  <div class="container footer-inner">
    <span>{profile.fullName} · {year}</span>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/writing">Writing</a>
      {ecosystem.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="/">Back to top</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-soft);
  }
  .footer-inner {
    padding-block: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-faint);
  }
  .footer-inner a {
    /* 21px tall previously — these are standalone nav links, so the WCAG
       2.5.8 inline exception doesn't apply and they need 24×24. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--ink-faint);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .footer-inner a:hover {
    color: var(--primary);
  }
</style>
