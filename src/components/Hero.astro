---
import { profile } from "../data/profile";
---

<section class="hero container">
  <div class="hero-top">
    <img class="hero-photo" src={profile.photo} alt={profile.photoAlt} width="104" height="104" />
    <div class="hero-heading">
      <h1>{profile.name}</h1>
      <p class="hero-title">{profile.title}</p>
    </div>
  </div>

  <p class="hero-tagline">{profile.tagline}</p>

  <div class="tag-row">
    {
      profile.credentials.map((c) =>
        c.url ? (
          <a class="tag tag-credential" href={c.url} target="_blank" rel="noopener noreferrer">
            {c.label} <span class="card-external">↗</span>
          </a>
        ) : (
          <span class="tag tag-credential">{c.label}</span>
        ),
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: 64px 48px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero-top {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .hero-photo {
    width: 104px;
    height: 104px;
    border-radius: 24px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    transition: transform 220ms ease;
  }
  .hero-photo:hover {
    transform: scale(1.03);
  }
  .hero-heading h1 {
    font-size: clamp(40px, 5.5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }
  .hero-title {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--primary);
    margin: 0;
  }
  .hero-tagline {
    color: var(--ink);
    margin: 0;
    max-width: 58ch;
    font-size: 20px;
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .hero-heading h1 {
      font-size: 34px;
    }
    .hero-top {
      gap: 14px;
    }
    .hero-photo {
      width: 76px;
      height: 76px;
      border-radius: 18px;
    }
  }
</style>
