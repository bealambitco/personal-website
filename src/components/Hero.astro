---
import { profile } from "../data/profile";
import { socials } from "../data/socials";

// Your most-checked profiles, surfaced right under your credentials so a
// visitor doesn't have to scroll to Contact to find them. Contact still
// exists separately for Email/Book a time. Add/remove labels here — it
// just filters the shared `socials` list, doesn't need its own data file.
// This list also sets the display order (not `socials.ts`'s order).
const handleLabels = ["LinkedIn", "GitHub", "Substack", "YouTube", "TikTok"];
const handles = handleLabels
  .map((label) => socials.find((s) => s.label === label))
  .filter((s): s is (typeof socials)[number] => !!s);
---

<section class="hero container">
  <div class="hero-top">
    <img class="hero-photo" src={profile.photo} alt={profile.photoAlt} width="104" height="104" />
    <div class="hero-heading">
      <h1>{profile.displayName}</h1>
      <p class="hero-title">{profile.title}</p>
    </div>
  </div>

  <p class="hero-tagline">{profile.tagline}</p>

  <div class="tag-row">
    {
      profile.credentials.map((c) =>
        c.url ? (
          <a class="tag tag-credential" href={c.url} target="_blank" rel="noopener noreferrer">
            {c.label} <span class="card-external">↗</span>
          </a>
        ) : (
          <span class="tag tag-credential">{c.label}</span>
        ),
      )
    }
  </div>

  <div class="handle-row">
    {
      handles.map((s, i) => (
        <>
          {i > 0 && <span class="handle-sep">·</span>}
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        </>
      ))
    }
  </div>
</section>

<style>
  .hero {
    padding-block: 64px 48px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero-top {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .hero-photo {
    width: 104px;
    height: 104px;
    border-radius: 24px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    transition: transform 220ms ease;
  }
  .hero-photo:hover {
    transform: scale(1.03);
  }
  .hero-heading h1 {
    /* sized for the full three-word name — bumping this back up will make
       it wrap awkwardly next to the photo at laptop widths */
    font-size: clamp(32px, 4.2vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }
  .hero-title {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--primary);
    margin: 0;
  }
  .hero-tagline {
    color: var(--ink);
    margin: 0;
    max-width: 58ch;
    font-size: 20px;
    line-height: 1.5;
  }
  .handle-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: -6px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .handle-row a {
    color: var(--ink-soft);
  }
  .handle-row a:hover {
    color: var(--primary);
  }
  .handle-sep {
    color: var(--border);
  }

  @media (max-width: 480px) {
    .hero-heading h1 {
      font-size: 26px;
    }
    .hero-top {
      gap: 14px;
    }
    .hero-photo {
      width: 76px;
      height: 76px;
      border-radius: 18px;
    }
  }
</style>
