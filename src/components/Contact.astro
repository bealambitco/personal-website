---
import { profile } from "../data/profile";

const contactHref = `mailto:${profile.email}?subject=${encodeURIComponent("Website or work inquiry")}`;
---

<section id="contact" class="section container contact">
  <p class="section-kicker">Consulting · Training · Speaking</p>
  <h2 class="section-title">Get in touch</h2>
  <p class="contact-intro">
    If your organization is planning a Data or AI transformation, upskilling a team, or organizing an event,
    send me a note about what you’re working on.
  </p>
  <div class="contact-actions">
    <a class="button button-primary" href={contactHref}>Email Bea</a>
    <span class="muted">{profile.location}</span>
  </div>

  <p class="suggest">
    Have another idea—a topic you'd like me to write about, a resource worth adding, or feedback on the site?
    {" "}<a href={contactHref}>Send it my way</a>.
  </p>
</section>

<style>
  .contact {
    padding-block: 88px;
  }
  .section-kicker {
    margin: 0 0 6px;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .contact-intro {
    max-width: 58ch;
    margin: 0 0 20px;
    color: var(--ink-soft);
    font-size: 18px;
  }
  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .suggest {
    margin: 24px 0 0;
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 58ch;
  }
</style>
