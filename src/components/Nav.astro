---
import { profile } from "../data/profile";
import MegaMenu from "./MegaMenu.astro";

const links = [
  { href: "/#timeline", label: "Timeline" },
  { href: "/#featured", label: "Featured" },
  { href: "/#experience", label: "Experience" },
];
---

<header class="nav">
  <div class="nav-inner container">
    <a class="nav-name" href="/">{profile.name}</a>
    <nav class="nav-links" aria-label="Section navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}

      <details class="nav-dropdown" name="nav-dropdown">
        <summary>Writing</summary>
        <div class="nav-dropdown-panel">
          <MegaMenu
            topLinks={[
              { href: "/#latest-articles", label: "Latest" },
              { href: "/topics", label: "All topics" },
              { href: "/writing", label: "All articles" },
            ]}
            hrefFor={(id) => `/topics/${id}`}
          />
        </div>
      </details>

      <details class="nav-dropdown" name="nav-dropdown">
        <summary>Resources</summary>
        <div class="nav-dropdown-panel">
          <MegaMenu
            topLinks={[{ href: "/resources", label: "All resources" }]}
            hrefFor={(id) => `/resources#${id}`}
          />
        </div>
      </details>

      <a href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-soft);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    position: relative;
  }
  .nav-name {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
    flex-shrink: 0;
  }
  .nav-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 8px;
    column-gap: 18px;
    justify-content: flex-end;
  }
  .nav-links > a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 14px;
    white-space: nowrap;
  }
  .nav-links > a:hover {
    color: var(--primary);
  }

  .nav-dropdown {
    position: static;
  }
  .nav-dropdown summary {
    color: var(--ink-soft);
    font-size: 14px;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }
  .nav-dropdown summary::after {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    margin-left: 6px;
    opacity: 0.7;
  }
  .nav-dropdown:hover summary,
  .nav-dropdown[open] summary {
    color: var(--primary);
  }
  .nav-dropdown-panel {
    position: absolute;
    top: 100%;
    right: 24px;
    margin-top: 10px;
    width: 520px;
    max-width: calc(100vw - 48px);
    padding: 16px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(30, 16, 48, 0.12);
  }

  @media (max-width: 640px) {
    .nav-dropdown-panel {
      position: static;
      width: 100%;
      margin-top: 12px;
      box-shadow: none;
    }
  }
</style>
