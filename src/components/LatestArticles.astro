---
import { getCollection } from "astro:content";
import CardList from "./CardList.astro";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const latest = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5)
  .map((post) => ({
    kind: "Article" as const,
    title: post.data.title,
    description: post.data.description,
    href: `/writing/${post.id}`,
    date: post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }),
  }));
---

<section id="latest-articles" class="section container">
  <div class="writing-heading">
    <h2 class="section-title">Writing</h2>
    <a href="/writing">Explore writing</a>
  </div>
  {
    latest.length > 0 ? (
      <CardList items={latest} />
    ) : (
      <p class="writing-intro">
        I’m preparing articles on practical Data & AI, career development, and learning. Published pieces will
        appear here.
      </p>
    )
  }
</section>

<style>
  .writing-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }
  .writing-heading a {
    /* Standalone link, not inline in a sentence — needs the WCAG 2.5.8
       24×24 minimum. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    flex-shrink: 0;
    font-size: 14px;
  }
  .writing-intro {
    max-width: 60ch;
    margin: 0;
    color: var(--ink-soft);
  }
</style>
